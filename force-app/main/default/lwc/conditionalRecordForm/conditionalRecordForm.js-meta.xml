<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Conditional Record Form</masterLabel>
    <description>Configurable record form with answer-driven conditional fields.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage,lightning__AppPage,lightning__HomePage,lightningCommunity__Default">
            <property name="objectApiName" type="String" label="Object API Name" description="Salesforce object to create or edit." />
            <property name="recordId" type="String" label="Record ID" description="Optional record ID; leave blank to create a record." />
            <property name="title" type="String" label="Form Title" default="Conditional Form" />
            <property name="description" type="String" label="Form Description" />
            <property name="submitLabel" type="String" label="Submit Button Label" default="Save" />
            <property name="formConfigJson" type="String" label="Form Configuration JSON" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
